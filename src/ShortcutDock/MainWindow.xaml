<Window x:Class="ShortcutDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShortcutDock.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ShortcutDock"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        AllowsTransparency="False"
        Background="{x:Null}"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewDragOver="OnDragOver"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="OnSizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1"
                            CornerRadius="10"
                            CaptionHeight="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                CornerRadius="10"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PanelOrientation}" Value="Horizontal">
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PanelOrientation}" Value="Vertical">
                            <Setter Property="Margin" Value="0,6" />
                            <Setter Property="Padding" Value="4,6" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="{Binding PanelOrientation}">
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border ToolTip="{Binding Name}"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Horizontal">
                                                <Setter Property="Margin" Value="4,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                                                <Setter Property="Margin" Value="0,4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Запустить от имени администратора"
                                                  Command="{Binding RunAsAdminCommand}" />
                                        <MenuItem Header="Изменить значок..."
                                                  Command="{Binding ChangeIconCommand}" />
                                        <Separator />
                                        <MenuItem Header="Удалить с панели"
                                                  Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border x:Name="IconContainer"
                                        Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        RenderTransformOrigin="0.5,0.5"
                                        Cursor="Hand">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding LaunchCommand}" />
                                    </Border.InputBindings>

                                    <Image Source="{Binding IconPath}"
                                           Margin="4"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="1.18" Duration="0:0:0.12" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="1.18" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                             To="1" Duration="0:0:0.12" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                             To="1" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Visibility="{Binding ShowAddButton, Converter={StaticResource BoolToVis}}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PanelOrientation}" Value="Horizontal">
                                    <Setter Property="Margin" Value="4,0,0,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PanelOrientation}" Value="Vertical">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <Button Command="{Binding AddViaDialogCommand}"
                            Width="32" Height="32"
                            ToolTip="Добавить приложение"
                            Style="{DynamicResource AccentButtonStyle}">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                    </Button>
                </ContentControl>
            </StackPanel>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Добавить приложение"
                          Command="{Binding AddViaDialogCommand}" />
                <MenuItem Header="Настройки панели"
                          Command="{Binding ShowSettingsCommand}" />
                <Separator />
                <MenuItem Header="Закрыть панель"
                          Click="OnCloseClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
