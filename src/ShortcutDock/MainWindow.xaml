<Window x:Class="ShortcutDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShortcutDock.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ShortcutDock"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        AllowsTransparency="False"
        Background="{x:Null}"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        PreviewDragOver="OnDragOver"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="OnSizeChanged"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1"
                            CornerRadius="10"
                            CaptionHeight="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Анимация отскока (прыгающей иконки) при клике -->
        <Storyboard x:Key="BounceStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[1].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-22">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CircleEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BounceEase Bounces="1" Bounciness="2.5" EasingMode="EaseIn" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder"
                CornerRadius="10"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PanelOrientation}" Value="Horizontal">
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PanelOrientation}" Value="Vertical">
                            <Setter Property="Margin" Value="0,6" />
                            <Setter Property="Padding" Value="2,6" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="{Binding PanelOrientation}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Position}" Value="Left">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Position}" Value="Right">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Position}" Value="Top">
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Position}" Value="Bottom">
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ItemsControl ItemsSource="{Binding Shortcuts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border ToolTip="{Binding Name}"
                                    Background="Transparent"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="Item_PreviewMouseLeftButtonUp"
                                    PreviewMouseMove="Item_PreviewMouseMove"
                                    DragOver="Item_DragOver"
                                    Drop="Item_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Horizontal">
                                                <Setter Property="Margin" Value="4,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.PanelOrientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                                                <Setter Property="Margin" Value="0,4" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Запустить от имени администратора"
                                                  Command="{Binding RunAsAdminCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="Очистить корзину"
                                                  Command="{Binding EmptyRecycleBinCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="Изменить значок..."
                                                  Command="{Binding ChangeIconCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator>
                                            <Separator.Style>
                                                <Style TargetType="Separator">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Separator.Style>
                                        </Separator>
                                        <MenuItem Header="Удалить с панели"
                                                  Command="{Binding RemoveCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecycleBin}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Border x:Name="IconContainer"
                                        Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        RenderTransformOrigin="0.5,0.5"
                                        Cursor="Hand">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="IconTranslate" X="0" Y="0" />
                                        </TransformGroup>
                                    </Border.RenderTransform>

                                    <Grid>
                                        <Image Source="{Binding IconPath}"
                                               Margin="4,4,4,8"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <!-- Точка-индикатор запущенной программы -->
                                        <Ellipse Width="5" Height="5"
                                                 Fill="{DynamicResource SystemAccentColorBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,0,2">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                                                <Condition Binding="{Binding IsRecycleBin}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Visibility="{Binding ShowAddButton, Converter={StaticResource BoolToVis}}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PanelOrientation}" Value="Horizontal">
                                    <Setter Property="Margin" Value="4,0,0,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PanelOrientation}" Value="Vertical">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                    <Button Command="{Binding AddViaDialogCommand}"
                            Width="32" Height="32"
                            ToolTip="Добавить приложение"
                            Style="{DynamicResource AccentButtonStyle}">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                    </Button>
                </ContentControl>
            </StackPanel>
        </Border>

        <Grid.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Добавить приложение"
                          Command="{Binding AddViaDialogCommand}" />
                <MenuItem Header="Настройки панели"
                          Command="{Binding ShowSettingsCommand}" />
                <Separator />
                <MenuItem Header="Закрыть панель"
                          Click="OnCloseClick" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</Window>
