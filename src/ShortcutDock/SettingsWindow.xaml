<ui:FluentWindow x:Class="ShortcutDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShortcutDock.ViewModels"
        Title="Настройки ShortcutDock"
        Height="510" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Настройки панели" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,8,16,16">
            <StackPanel>
                <!-- Position -->
                <ui:CardControl Header="Положение на экране" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="PositionToFront24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Position, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="Снизу" Tag="Bottom" />
                        <ComboBoxItem Content="Сверху" Tag="Top" />
                        <ComboBoxItem Content="Слева" Tag="Left" />
                        <ComboBoxItem Content="Справа" Tag="Right" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Backdrop Effect -->
                <ui:CardControl Header="Эффект размытия" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="SurfaceHub24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding BackdropType, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="Нет (прозрачный)" Tag="None" />
                        <ComboBoxItem Content="Mica" Tag="Mica" />
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Icon Size -->
                <ui:CardControl Header="Размер значков" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding IconSizeString, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="32 px" Tag="32" />
                        <ComboBoxItem Content="40 px" Tag="40" />
                        <ComboBoxItem Content="48 px" Tag="48" />
                        <ComboBoxItem Content="64 px" Tag="64" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Keep on Top -->
                <ui:CardControl Header="Поверх всех окон" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Pin24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding KeepOnTop, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Show Add Button -->
                <ui:CardControl Header="Показывать кнопку «+» на панели" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="AddCircle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding ShowAddButton, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Start with Windows -->
                <ui:CardControl Header="Запускать вместе с Windows" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="WindowApps24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Show Recycle Bin -->
                <ui:CardControl Header="Отображать Корзину на панели" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding ShowRecycleBin, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Auto Hide -->
                <ui:CardControl Header="Автоматически скрывать панель (Auto-Hide)" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding AutoHide, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Hover Zoom -->
                <ui:CardControl Header="Эффект увеличения при наведении (Hover Zoom)" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ZoomIn24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding HoverZoom, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Show Running Indicators -->
                <ui:CardControl Header="Индикаторы запущенных программ" Margin="0,0,0,16">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="StatusCircle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding ShowRunningIndicators, Mode=TwoWay}" />
                </ui:CardControl>

                <Button Content="Закрыть" 
                        Click="OnCloseClick"
                        HorizontalAlignment="Right" 
                        Style="{DynamicResource AccentButtonStyle}"
                        Width="100" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
