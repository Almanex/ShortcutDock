<ui:FluentWindow x:Class="ShortcutDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:ShortcutDock.ViewModels"
        Title="{DynamicResource SettingsTitle}"
        Height="540" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource SettingsHeader}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,8,16,16" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel>
                <!-- Language Selection -->
                <ui:CardControl Header="{DynamicResource SettingLanguage}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="LocalLanguage24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                        <ComboBoxItem Content="Deutsch" Tag="de" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Position -->
                <ui:CardControl Header="{DynamicResource SettingPosition}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="PositionToFront24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Position, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="{DynamicResource PositionBottom}" Tag="Bottom" />
                        <ComboBoxItem Content="{DynamicResource PositionTop}" Tag="Top" />
                        <ComboBoxItem Content="{DynamicResource PositionLeft}" Tag="Left" />
                        <ComboBoxItem Content="{DynamicResource PositionRight}" Tag="Right" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Backdrop Effect -->
                <ui:CardControl Header="{DynamicResource SettingBackdrop}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="SurfaceHub24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding BackdropType, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="{DynamicResource BackdropNone}" Tag="None" />
                        <ComboBoxItem Content="{DynamicResource BackdropMica}" Tag="Mica" />
                        <ComboBoxItem Content="{DynamicResource BackdropAcrylic}" Tag="Acrylic" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Icon Size -->
                <ui:CardControl Header="{DynamicResource SettingIconSize}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </ui:CardControl.Icon>
                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding IconSizeString, Mode=TwoWay}" Width="140">
                        <ComboBoxItem Content="32 px" Tag="32" />
                        <ComboBoxItem Content="40 px" Tag="40" />
                        <ComboBoxItem Content="48 px" Tag="48" />
                        <ComboBoxItem Content="64 px" Tag="64" />
                    </ComboBox>
                </ui:CardControl>

                <!-- Keep on Top -->
                <ui:CardControl Header="{DynamicResource SettingKeepOnTop}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Pin24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding KeepOnTop, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Show Add Button -->
                <ui:CardControl Header="{DynamicResource SettingShowAddButton}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="AddCircle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding ShowAddButton, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Start with Windows -->
                <ui:CardControl Header="{DynamicResource SettingStartWithWindows}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="WindowApps24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Show Recycle Bin -->
                <ui:CardControl Header="{DynamicResource SettingShowRecycleBin}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding ShowRecycleBin, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Auto Hide -->
                <ui:CardControl Header="{DynamicResource SettingAutoHide}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="EyeOff24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding AutoHide, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Hover Zoom -->
                <ui:CardControl Header="{DynamicResource SettingHoverZoom}" Margin="0,0,0,8">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ZoomIn24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch IsChecked="{Binding HoverZoom, Mode=TwoWay}" />
                </ui:CardControl>

                <!-- Folder Fan Opacity -->
                <ui:CardControl Header="{DynamicResource SettingFolderFanOpacity}" Margin="0,0,0,16">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Folder24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="100" Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding FolderFanOpacity, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding FolderFanOpacityPercentString}" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                    </StackPanel>
                </ui:CardControl>

                <Button Content="{DynamicResource BtnClose}" 
                        Click="OnCloseClick"
                        HorizontalAlignment="Right" 
                        Style="{DynamicResource AccentButtonStyle}"
                        Width="100" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
